#!/usr/bin/env python3
from pathlib import Path
import os

ROOT = Path(os.environ.get('BLACKSTOCK_ROOT', Path.cwd()))

def read(rel):
    return (ROOT / rel).read_text()

def write(rel, text):
    path = ROOT / rel
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text)

def replace_once(text, old, new, label):
    if old not in text:
        raise SystemExit(f'BLACKSTOCK_CREATOR_BUSINESS_OS_PATCH_MISSING: {label}')
    return text.replace(old, new, 1)

# 1) Navigation: creator-business workflow instead of legacy feature buckets.
models = read('Sources/Blackstock/Models/Models.swift')
models = replace_once(
    models,
    '  case command, chancen, factory, produktionen, veroeffentlicht, kalender, wachstum, konten,\n    bibliothek,\n',
    '  case command, chancen, research, ideen, factory, produktionen, veroeffentlicht, kalender, wachstum, konten,\n    bibliothek,\n',
    'navigation cases')
models = replace_once(models, '    case .command: "Dashboard"\n    case .chancen: "Trends"\n', '    case .command: "Start"\n    case .chancen: "Entdecken"\n    case .research: "Recherche"\n    case .ideen: "Ideen"\n', 'navigation titles head')
models = replace_once(models, '    case .produktionen: "Erstellen"\n    case .veroeffentlicht: "Inhalte"\n', '    case .produktionen: "Studio"\n    case .veroeffentlicht: "Veröffentlichen"\n', 'navigation titles studio')
models = replace_once(models, '    case .konten: "Kanal"\n', '    case .konten: "Kanäle"\n', 'navigation title channels')
models = replace_once(models, '    case .command: "cpu.fill"\n    case .chancen: "chart.line.uptrend.xyaxis"\n', '    case .command: "house.fill"\n    case .chancen: "safari.fill"\n    case .research: "doc.text.magnifyingglass"\n    case .ideen: "lightbulb.max.fill"\n', 'navigation symbols')
write('Sources/Blackstock/Models/Models.swift', models)

sidebar = read('Sources/Blackstock/Views/SidebarView.swift')
sidebar = replace_once(
    sidebar,
    '  private let primaryTargets: [Navigationsziel] = [\n    .command, .chancen, .produktionen, .veroeffentlicht, .wachstum, .konten,\n  ]\n',
    '  private let primaryTargets: [Navigationsziel] = [\n    .command, .chancen, .research, .ideen, .produktionen, .veroeffentlicht, .wachstum, .konten,\n  ]\n',
    'sidebar primary workflow')
write('Sources/Blackstock/Views/SidebarView.swift', sidebar)

root = read('Sources/Blackstock/Views/RootView.swift')
root = replace_once(root, '    case .chancen: ChancenView()\n    case .factory: ProduktionenView()\n', '    case .chancen: ChancenView()\n    case .research: ResearchWorkspaceView()\n    case .ideen: IdeasWorkspaceView()\n    case .factory: ProduktionenView()\n', 'root routes')
write('Sources/Blackstock/Views/RootView.swift', root)

# 2) Discovery: no English-only or >=4min gate; include Shorts and long-tail references.
yt = read('Sources/Blackstock/Services/YouTubeService.swift')
yt = yt.replace(
'''    // Blackstock sucht bewusst themenbezogen statt einen allgemeinen "Markt" zu simulieren.\n    // Dadurch bleiben die Treffer an das Kanalthema gebunden und die Such-API kann\n    // relevanceLanguage=en verwenden.\n''',
'''    // Blackstock sucht bewusst themenbezogen statt einen allgemeinen "Markt" zu simulieren.\n    // Sprache und Format werden nicht künstlich eingeschränkt: Shorts, reguläre Videos,\n    // internationale Treffer und Long-Tail-Nischen dürfen als Marktsignale erscheinen.\n''')
yt = replace_once(yt, '    // Sechs Suchabfragen pro Lauf halten das YouTube-Quota kontrollierbar.\n', '    // Vier Themen pro Lauf halten das YouTube-Quota trotz drei Dauerklassen kontrollierbar.\n', 'quota comment')
yt = replace_once(yt, '      guard alleThemen.count > 6 else { return alleThemen }\n      let start = (discoveryCursor * 6) % alleThemen.count\n      return (0..<6).map { alleThemen[(start + $0) % alleThemen.count] }\n', '      guard alleThemen.count > 4 else { return alleThemen }\n      let start = (discoveryCursor * 4) % alleThemen.count\n      return (0..<4).map { alleThemen[(start + $0) % alleThemen.count] }\n', 'quota topic window')
yt = replace_once(
    yt,
'''    // Blackstock verwendet bewusst keine Shorts als Schnittquelle. Die zwei offiziellen\n    // YouTube-Dauerklassen decken 4–20 Minuten und >20 Minuten ab, ohne zusätzliche\n    // Search-Aufrufe gegenüber dem bisherigen Zwei-Seiten-Ansatz zu erzeugen.\n    let sourceBuckets: [(duration: String, order: String, label: String)] = [\n      ("medium", "viewCount", "4–20 Min"),\n      ("long", "relevance", "20+ Min"),\n    ]\n''',
'''    // YouTube kennt drei offizielle Such-Dauerklassen. Alle drei werden als Signale\n    // berücksichtigt; kurze Treffer sind Referenzen und werden nicht automatisch gerippt.\n    let sourceBuckets: [(duration: String, order: String, label: String)] = [\n      ("short", "relevance", "unter 4 Min."),\n      ("medium", "viewCount", "4–20 Min."),\n      ("long", "relevance", "20+ Min."),\n    ]\n''',
    'source buckets')
yt = yt.replace('          URLQueryItem(name: "relevanceLanguage", value: "en"),\n', '')
yt = replace_once(
    yt,
'''        for video in videos.items where video.status?.embeddable != false {\n          