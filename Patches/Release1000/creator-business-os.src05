nuous))
  }

  private func recommendedFormat(for chance: Chance) -> VideoFormat {
    if let duration = chance.youtubeDurationSeconds, duration < 90 { return .short }
    if chance.phase == .beschleunigend && (chance.youtubeDurationSeconds ?? 0) < 8 * 60 { return .short }
    if chance.evergreenScore >= 62 { return .longform }
    return chance.empfohleneFormate.contains(.longform) ? .longform : (chance.empfohleneFormate.first ?? .longform)
  }

  private func briefReason(_ chance: Chance, format: VideoFormat) -> String {
    switch format {
    case .short:
      return "Nutze das Video als Trend-Signal: neuer Hook und eigener Inhalt, ein klarer Kernpunkt, schnelle visuelle Progression."
    case .longform:
      return "Nutze die Referenz für Themen- und Packaging-Research. Baue eine eigene These, Belege, Kapitel und stärkere Zuschauerbindung."
    case .serie:
      return "Das Thema eignet sich als wiederholbares Format. Definiere einen festen Aufbau und variiere Fragestellung und Belege pro Folge."
    case .livestream:
      return "Nutze das Signal für einen Live-Anlass mit klarer Agenda und eigenem Kommentar."
    }
  }
}

private func researchCompactNumber(_ value: Int) -> String {
  if value >= 1_000_000 { return String(format: "%.1fM", Double(value) / 1_000_000) }
  if value >= 1_000 { return String(format: "%.1fK", Double(value) / 1_000) }
  return "\(value)"
}

private func researchDuration(_ seconds: Double) -> String {
  let total = max(0, Int(seconds.rounded()))
  let hours = total / 3600
  let minutes = (total % 3600) / 60
  let secs = total % 60
  if hours > 0 { return String(format: "%d:%02d:%02d", hours, minutes, secs) }
  return String(format: "%d:%02d", minutes, secs)
}
'''
write('Sources/Blackstock/Views/CreatorBusinessWorkspaceView.swift', workspace)

# 5) Release audit: validate the new architecture and remove stale dashboard-copy guard.
audit = read('Build/Release-Audit.sh')
audit = audit.replace('grep -q \'Nächste Schritte\' "$ROOT/Sources/Blackstock/Views/CreatorOS1000View.swift" || fail "Klarer Next-Step-Bereich fehlt"\n', 'grep -q \'Creator Business Workflow\' "$ROOT/Sources/Blackstock/Views/CreatorOS1000View.swift" || fail "Creator-Business-Workflow fehlt"\n')
append = r'''

# BLACKSTOCK_CREATOR_BUSINESS_OS_GUARDS
grep -q 'case command, chancen, research, ideen' "$ROOT/Sources/Blackstock/Models/Models.swift" || fail "Recherche/Ideen Navigation fehlt"
grep -q 'case .research: ResearchWorkspaceView()' "$ROOT/Sources/Blackstock/Views/RootView.swift" || fail "Recherche Workspace nicht geroutet"
grep -q 'case .ideen: IdeasWorkspaceView()' "$ROOT/Sources/Blackstock/Views/RootView.swift" || fail "Ideen Workspace nicht geroutet"
[[ -f "$ROOT/Sources/Blackstock/Views/CreatorBusinessWorkspaceView.swift" ]] || fail "Creator Business Workspaces fehlen"
grep -q 'Nischen-Radar' "$ROOT/Sources/Blackstock/Views/CreatorBusinessWorkspaceView.swift" || fail "Nischen-Radar fehlt"
grep -q 'Content Briefs' "$ROOT/Sources/Blackstock/Views/CreatorBusinessWorkspaceView.swift" || fail "Ideen-Briefs fehlen"
grep -q '("short", "relevance", "unter 4 Min.")' "$ROOT/Sources/Blackstock/Services/YouTubeService.swift" || fail "Kurze YouTube-Signale fehlen"
! grep -q 'relevanceLanguage", value: "en"' "$ROOT/Sources/Blackstock/Services/YouTubeService.swift" || fail "Discovery ist noch auf Englisch beschränkt"
! grep -q 'sourceDuration >= 240' "$ROOT/Sources/Blackstock/Services/YouTubeService.swift" || fail "Discovery filtert weiterhin unter 4 Minuten"
! grep -q 'prefix(300)' "$ROOT/Sources/Blackstock/Services/YouTubeService.swift" || fail "Künstlicher 300er Discovery-Cap ist noch aktiv"
echo BLACKSTOCK_CREATOR_BUSINESS_OS_OK
'''
if 'BLACKSTOCK_CREATOR_BUSINESS_OS_GUARDS' not in audit:
    audit += append
write('Build/Release-Audit.sh', audit)

print('BLACKSTOCK_CREATOR_BUSINESS_OS_PATCH_OK')
