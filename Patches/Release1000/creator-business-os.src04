tent-Briefs – ohne den Referenzclip als eigene Datei auszugeben.",
          trailing: AnyView(channelPicker))
        ideaControls
        formatStrategy
        ideaList
      }
      .padding(24)
    }
    .onAppear {
      if selectedChannelID == nil { selectedChannelID = store.v12ActiveChannelID ?? store.liveKanaele.first?.id }
    }
  }

  private var channelPicker: some View {
    Picker("Kanal", selection: $selectedChannelID) {
      Text("Kanal auswählen").tag(UUID?.none)
      ForEach(store.liveKanaele) { channel in Text(channel.name).tag(Optional(channel.id)) }
    }
    .frame(width: 220)
  }

  private var ideaControls: some View {
    HStack(spacing: 10) {
      HStack(spacing: 8) {
        Image(systemName: "magnifyingglass").foregroundStyle(Color.bsMuted)
        TextField("Ideen nach Thema durchsuchen", text: $query).textFieldStyle(.plain)
      }
      .padding(.horizontal, 11).frame(maxWidth: .infinity, minHeight: 36)
      .background(Color.bsSurface2).clipShape(RoundedRectangle(cornerRadius: 9))
      Button { store.ausgewaehltesZiel = .research } label: {
        Label("Recherche", systemImage: "doc.text.magnifyingglass")
      }.buttonStyle(.bordered)
    }
  }

  private var formatStrategy: some View {
    HStack(alignment: .top, spacing: 12) {
      strategyCard("Short", "Schneller Hook, ein klarer Payoff, vertikale Komposition.", "rectangle.portrait.fill")
      strategyCard("Langvideo", "Mehr Belege, stärkere Struktur, Retention über Kapitel.", "rectangle.fill")
      strategyCard("Serie", "Wiederholbares Format für Themen mit mehreren belastbaren Signalen.", "square.stack.3d.up.fill")
    }
  }

  private func strategyCard(_ title: String, _ text: String, _ symbol: String) -> some View {
    HStack(alignment: .top, spacing: 10) {
      Image(systemName: symbol).foregroundStyle(Color.bsRed).frame(width: 22)
      VStack(alignment: .leading, spacing: 3) {
        Text(title).font(.system(size: 10.5, weight: .semibold)).foregroundStyle(Color.bsText)
        Text(text).font(.system(size: 8.8)).foregroundStyle(Color.bsMuted).fixedSize(horizontal: false, vertical: true)
      }
      Spacer()
    }
    .blackstockCard(12)
  }

  private var ideaList: some View {
    VStack(alignment: .leading, spacing: 12) {
      HStack {
        AbschnittTitel(
          titel: "Content Briefs",
          untertitel: "Gespeicherte Referenzen zuerst, danach weitere passende Markt- und Nischensignale.")
        Spacer()
        Text("\(candidates.count) Ideen").font(.system(size: 9.5, weight: .semibold)).foregroundStyle(Color.bsMuted)
      }
      if candidates.isEmpty {
        Text("Noch keine Signale vorhanden. Lade in Entdecken Videos für deinen Kanal.")
          .font(.system(size: 10)).foregroundStyle(Color.bsMuted)
      } else {
        LazyVStack(spacing: 10) {
          ForEach(candidates) { chance in ideaCard(chance) }
        }
      }
    }
    .blackstockCard(16, elevated: true)
  }

  private func ideaCard(_ chance: Chance) -> some View {
    let recommended = recommendedFormat(for: chance)
    return VStack(alignment: .leading, spacing: 9) {
      HStack(alignment: .top, spacing: 10) {
        VStack(alignment: .leading, spacing: 4) {
          HStack(spacing: 7) {
            Text(chance.thema.uppercased()).font(.system(size: 8, weight: .bold)).tracking(0.8).foregroundStyle(Color.bsRed)
            if let id = chance.youtubeVideoID, store.v100State.shortlistedVideoIDs.contains(id) {
              Label("GESPEICHERT", systemImage: "bookmark.fill").font(.system(size: 7.5, weight: .bold)).foregroundStyle(Color.bsMuted)
            }
          }
          Text(chance.titel).font(.system(size: 13, weight: .semibold)).foregroundStyle(Color.bsText).lineLimit(2)
          Text(briefReason(chance, format: recommended)).font(.system(size: 9)).foregroundStyle(Color.bsMuted).lineLimit(3)
        }
        Spacer()
        VStack(alignment: .trailing, spacing: 4) {
          Text(recommended.rawValue).font(.system(size: 9, weight: .bold)).foregroundStyle(Color.bsText)
          if let duration = chance.youtubeDurationSeconds { Text("Quelle: \(researchDuration(duration))").font(.system(size: 8)).foregroundStyle(Color.bsMuted2) }
        }
      }
      HStack {
        if let channel = chance.youtubeChannelTitle {
          Label(channel, systemImage: "play.rectangle").font(.system(size: 8.5)).foregroundStyle(Color.bsMuted)
        }
        if let views = chance.youtubeViews {
          Text("· \(researchCompactNumber(views)) Views").font(.system(size: 8.5)).foregroundStyle(Color.bsMuted)
        }
        Spacer()
        Button {
          if let id = store.produktionAusChance(chance, format: recommended, modus: .studio, publikationsmodus: .review) {
            store.ausgewaehlteProduktionID = id
            store.ausgewaehltesZiel = .produktionen
          }
        } label: {
          Label("Im Studio öffnen", systemImage: "wand.and.stars")
        }
        .buttonStyle(.borderedProminent).tint(Color.bsRed).foregroundStyle(.white).controlSize(.small)
      }
    }
    .padding(12)
    .background(Color.bsSurface2)
    .clipShape(RoundedRectangle(cornerRadius: 11, style: .conti