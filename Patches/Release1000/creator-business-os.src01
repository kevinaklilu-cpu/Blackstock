        VStack(alignment: .leading, spacing: 2) {
          Text(title).font(.system(size: 10.5, weight: .semibold)).foregroundStyle(Color.bsText)
          Text(subtitle).font(.system(size: 8.5)).foregroundStyle(Color.bsMuted).lineLimit(1)
        }
        Spacer(minLength: 4)
        Image(systemName: "chevron.right").font(.system(size: 8, weight: .semibold)).foregroundStyle(Color