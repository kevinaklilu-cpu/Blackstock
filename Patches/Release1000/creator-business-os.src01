guard let duration = video.contentDetails.flatMap({ parseISODuration($0.duration) }), duration >= 240 else {\n            continue\n          }\n          let declaredLanguage = video.snippet.defaultAudioLanguage ?? video.snippet.defaultLanguage\n          if let declaredLanguage, !declaredLanguage.isEmpty,\n            !declaredLanguage.lowercased().hasPrefix("en")\n          {\n            continue\n          }\n\n          geseheneVideoIDs.insert(video.id)\n''',
'''        for video in videos.items where video.status?.embeddable != false {\n          guard let duration = video.contentDetails.flatMap({ parseISODuration($0.duration) }), duration > 0 else {\n            continue\n          }\n\n          geseheneVideoIDs.insert(video.id)\n''',
    'video duration and language gate')
